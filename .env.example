# Copy to .env.local and fill in. Never commit .env.local.
#   cp .env.example .env.local

# --- Meta Model API (required for golden path) ---
# Dashboard: https://dev.meta.ai/platform
# Add a payment method or requests will fail.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Spark / Wonder (app uses Spark 1.3 for IntentCard + ExitBrief)
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_WONDER_MODEL=muse-wonder-1.0
MUSE_IMAGE_MODEL=muse-image-1.0
MUSE_VOICE_MODEL=muse-voice-transcribe-1.0
MUSE_SAM_MODEL=sam-3.1

# Optional: Claude Code / Muse Code CLI on your machine (not the Next.js app)
# ANTHROPIC_BASE_URL=https://api.meta.ai
# ANTHROPIC_AUTH_TOKEN=

# --- Baseten (open-weight fallback: muse-spark-open-1026) ---
# https://app.baseten.co/overview
BASETEN_API_KEY=
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026

# --- Modal (optional serverless / partner path) ---
# After: modal token new
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# --- Fireworks (only if you received hackathon credits) ---
FIREWORKS_API_KEY=

# --- App ---
# Demo timer: compact limit for video (seconds). 45 = 45s instead of 15 min.
NEXT_PUBLIC_DEMO_LIMIT_SECONDS=45
NEXT_PUBLIC_DEFAULT_LIMIT_MINUTES=15
